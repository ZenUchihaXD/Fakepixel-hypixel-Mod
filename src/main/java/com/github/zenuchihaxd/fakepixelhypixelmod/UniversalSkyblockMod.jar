@Mod(modid = UniversalSkyblockMod.MODID, name = UniversalSkyblockMod.NAME, version = UniversalSkyblockMod.VERSION, clientSideOnly = true)
public class UniversalSkyblockMod {

    public static final String MODID = "universalsb";
    public static final String NAME = "Universal SkyBlock All-In-One";
    public static final String VERSION = "3.0.0";

    // Keybindings
    public static KeyBinding lockSlotKey;
    public static KeyBinding openGuiKey;

    // Feature Toggles (Saved in Config)
    public static boolean forceEnableEverywhere = false; // Useful if scoreboard is hidden
    public static boolean inSkyblock = false;
    public static boolean isFakepixel = false;
    public static boolean enableTooltips = true;
    public static boolean enableHud = true;
    public static boolean enableTerminalSolvers = true;
    public static boolean enableDungeonESP = true;
    public static boolean enableSlotLocking = true;
    public static boolean enableScrollTooltips = true;
    public static boolean enableStemProtection = true;
    public static boolean enableCooldowns = true;
    public static boolean openMenuNextTick = false;

    // HUD Position
    public static int hudX = 8;
    public static int hudY = 8;

    // Scrollable Tooltip Offset
    private static int tooltipScrollY = 0;

    // Persistent Storage
    private static final Set<Integer> lockedSlots = new HashSet<>();
    private static File configFile;

    // Economy Databases
    public static final Map<String, Double> lowestBinMap = new ConcurrentHashMap<>();
    public static final Map<String, Double> fakepixelLocalBinMap = new ConcurrentHashMap<>();
    public static final Map<String, Double> bazaarBuyMap = new ConcurrentHashMap<>();
    public static final Map<String, Double> bazaarSellMap = new ConcurrentHashMap<>();
    public static String apiStatus = "Fetching...";
    private final NumberFormat formatter = NumberFormat.getInstance(Locale.US);

    // Reflection Fields for GuiContainer
    private static Field guiLeftField;
    private static Field guiTopField;

    // Action Bar & Scoreboard Trackers
    private String currentHealth = "100/100";
    private String currentDefense = "0";
    private String currentMana = "100/100";
    private int currentEHP = 100;
    private String slayerQuestLine = "None";
    private String dungeonSecretsLine = "";
    private int zealotsSinceEye = 0;
    private int totalZealots = 0;
    private long miningSpeedBoostReadyAt = 0;
    private int tickCounter = 0;

    // Item Cooldown Tracking (Item ID -> Expiration Timestamp)
    private final Map<String, Long> cooldownMap = new HashMap<>();

    // Three Weirdos NPC Puzzle Solutions
    private static final String[] WEIRDO_SOLUTIONS = {
        "The reward is not in my chest!",
        "At least one of them is lying, and the reward is not in ",
        "My chest doesn't have the reward. We are all telling the truth.",
        "My chest has the reward and I'm telling the truth!",
        "The reward isn't in any of our chests.",
        "Both of them are telling the truth. Also, "
    };

    // Regex Patterns
    private final Pattern hpPattern = Pattern.compile("([0-9,]+)/([0-9,]+)❤");
    private final Pattern defPattern = Pattern.compile("([0-9,]+)❈");
    private final Pattern manaPattern = Pattern.compile("([0-9,]+/[0-9,]+)✎");
    private final Pattern secretsPattern = Pattern.compile("([0-9]+/[0-9]+) Secrets");
    private final Pattern fakepixelBinPattern = Pattern.compile("Buy it now: ([0-9,]+) coins");

    @Mod.EventHandler
    public void init(FMLInitializationEvent event) {
        // 1. Bypass PojavLauncher / Old Java 8 SSL Certificate Errors first!
        bypassPojavSSL();

        // 2. Register Keybinds
        lockSlotKey = new KeyBinding("Lock/Unlock Slot", Keyboard.KEY_L, "Universal SkyBlock");
        openGuiKey = new KeyBinding("Open USB Mod Menu", Keyboard.KEY_RSHIFT, "Universal SkyBlock");
        ClientRegistry.registerKeyBinding(lockSlotKey);
        ClientRegistry.registerKeyBinding(openGuiKey);

        // 3. Setup Reflection for accurate GUI slot positions
        try {
            guiLeftField = ReflectionHelper.findField(GuiContainer.class, "guiLeft", "field_147003_i");
            guiTopField = ReflectionHelper.findField(GuiContainer.class, "guiTop", "field_147009_r");
            guiLeftField.setAccessible(true);
            guiTopField.setAccessible(true);
        } catch (Exception ignored) {}

        // 4. Load Saved Config & Locked Slots
        configFile = new File(Minecraft.getMinecraft().mcDataDir, "config/universalsb_config.properties");
        loadConfig();

        // 5. Register Events & Commands
        MinecraftForge.EVENT_BUS.register(this);
        ClientCommandHandler.instance.registerCommand(new UsbCommand());

        // 6. Start Background API Price Fetcher
        Executors.newSingleThreadScheduledExecutor().scheduleAtFixedRate(() -> {
            fetchLowestBins();
            fetchBazaarPrices();
        }, 0, 5, TimeUnit.MINUTES);
    }

    // =========================================================================
    // 1. POJAVLAUNCHER / ANDROID SSL BYPASS & API FETCHERS
    // =========================================================================
    private static void bypassPojavSSL() {
        try {
            TrustManager[] trustAllCerts = new TrustManager[]{
                new X509TrustManager() {
                    public X509Certificate[] getAcceptedIssuers() { return null; }
                    public void checkClientTrusted(X509Certificate[] certs, String authType) {}
                    public void checkServerTrusted(X509Certificate[] certs, String authType) {}
                }
            };
            SSLContext sc = SSLContext.getInstance("TLS");
            sc.init(null, trustAllCerts, new SecureRandom());
            HttpsURLConnection.setDefaultSSLSocketFactory(sc.getSocketFactory());
            HttpsURLConnection.setDefaultHostnameVerifier((hostname, session) -> true);
        } catch (Exception ignored) {}
    }

    private static void fetchLowestBins() {
        try {
            HttpURLConnection conn = (HttpURLConnection) new URL("https://moulberry.codes/lowestbin.json").openConnection();
            conn.setRequestProperty("User-Agent", "Mozilla/5.0 (UniversalSkyblockMod/3.0)");
            conn.setConnectTimeout(10000);
            conn.setReadTimeout(10000);
            JsonObject json = new JsonParser().parse(new InputStreamReader(conn.getInputStream())).getAsJsonObject();
            for (Map.Entry<String, JsonElement> e : json.entrySet()) {
                lowestBinMap.put(e.getKey().toUpperCase(), e.getValue().getAsDouble());
            }
            apiStatus = "Online (" + lowestBinMap.size() + " items)";
        } catch (Exception e) {
            apiStatus = "LBIN Error: " + e.getClass().getSimpleName();
        }
    }

    private static void fetchBazaarPrices() {
        try {
            HttpURLConnection conn = (HttpURLConnection) new URL("https://api.hypixel.net/skyblock/bazaar").openConnection();
            conn.setRequestProperty("User-Agent", "Mozilla/5.0 (UniversalSkyblockMod/3.0)");
            conn.setConnectTimeout(10000);
            conn.setReadTimeout(10000);
            JsonObject root = new JsonParser().parse(new InputStreamReader(conn.getInputStream())).getAsJsonObject();
            if (root.has("products")) {
                JsonObject products = root.getAsJsonObject("products");
                for (Map.Entry<String, JsonElement> e : products.entrySet()) {
                    JsonObject qs = e.getValue().getAsJsonObject().getAsJsonObject("quick_status");
                    bazaarBuyMap.put(e.getKey().toUpperCase(), qs.get("buyPrice").getAsDouble());
                    bazaarSellMap.put(e.getKey().toUpperCase(), qs.get("sellPrice").getAsDouble());
                }
            }
        } catch (Exception ignored) {}
    }

    // =========================================================================
    // 2. SERVER DETECTION, SCOREBOARD PARSING & FAKEPIXEL AH SCRAPER
    // =========================================================================
    @SubscribeEvent
    public void onClientTick(TickEvent.ClientTickEvent event) {
        if (event.phase != TickEvent.Phase.END) return;
        Minecraft mc = Minecraft.getMinecraft();

        if (openMenuNextTick) {
            openMenuNextTick = false;
            mc.displayGuiScreen(new UsbConfigGui());
        }

        if (openGuiKey.isPressed()) {
            mc.displayGuiScreen(new UsbConfigGui());
        }

        if (mc.theWorld == null || mc.thePlayer == null) {
            inSkyblock = false;
            return;
        }

        // Scrape Fakepixel Auction House if a Chest GUI is open
        if (mc.currentScreen instanceof GuiChest) {
            scrapeAuctionHouseChest((GuiChest) mc.currentScreen);
        } else {
            tooltipScrollY = 0; // Reset tooltip scroll when closing inventory
        }

        if (++tickCounter < 15) return;
        tickCounter = 0;

        if (forceEnableEverywhere) {
            inSkyblock = true;
            return;
        }

        Scoreboard sb = mc.theWorld.getScoreboard();
        if (sb == null) return;
        ScoreObjective obj = sb.getObjectiveInDisplaySlot(1);

        if (obj != null) {
            String title = StringUtils.stripControlCodes(obj.getDisplayName()).toUpperCase();
            inSkyblock = title.contains("SKYBLOCK") || title.contains("SKIBLOCK") || title.contains("FAKEPIXEL");

            slayerQuestLine = "None";
            isFakepixel = false;
            Collection<Score> scores = sb.getSortedScores(obj);
            for (Score score : scores) {
                ScorePlayerTeam team = sb.getPlayersTeam(score.getPlayerName());
                String line = StringUtils.stripControlCodes(ScorePlayerTeam.formatPlayerName(team, score.getPlayerName())).trim();
                if (line.toLowerCase().contains("fakepixel")) isFakepixel = true;
                if (line.contains("Slay the boss!") || line.contains("Combat XP") || line.contains("Kills")) {
                    slayerQuestLine = line;
                }
            }
        } else {
            inSkyblock = false;
        }
    }

    private void scrapeAuctionHouseChest(GuiChest chestGui) {
        try {
            ContainerChest cc = (ContainerChest) chestGui.inventorySlots;
            IInventory inv = cc.getLowerChestInventory();
            String title = StringUtils.stripControlCodes(inv.getDisplayName().getUnformattedText());
            if (!title.contains("Auctions") && !title.contains("Auction House")) return;

            for (int i = 0; i < inv.getSizeInventory(); i++) {
                ItemStack stack = inv.getStackInSlot(i);
                if (stack == null || !stack.hasTagCompound()) continue;
                NBTTagCompound display = stack.getTagCompound().getCompoundTag("display");
                if (!display.hasKey("Lore", 9)) continue;

                NBTTagList lore = display.getTagList("Lore", 8);
                for (int j = 0; j < lore.tagCount(); j++) {
                    String line = StringUtils.stripControlCodes(lore.getStringTagAt(j));
                    Matcher m = fakepixelBinPattern.matcher(line);
                    if (m.find()) {
                        double price = Double.parseDouble(m.group(1).replace(",", ""));
                        String id = resolveItemId(stack);
                        if (id != null) {
                            double existing = fakepixelLocalBinMap.getOrDefault(id, Double.MAX_VALUE);
                            if (price < existing) {
                                fakepixelLocalBinMap.put(id, price);
                            }
                        }
                    }
                }
            }
        } catch (Exception ignored) {}
    }

    // =========================================================================
    // 3. LIVE PRICE TOOLTIPS, DRILL FUEL & SCROLLABLE TOOLTIPS
    // =========================================================================
    @SubscribeEvent
    public void onItemTooltip(ItemTooltipEvent event) {
        if ((!inSkyblock && !forceEnableEverywhere) || !enableTooltips || event.itemStack == null) return;

        // Scrollable Tooltips Adjustment via Keyboard UP/DOWN or Mouse Wheel
        if (enableScrollTooltips) {
            int wheel = Mouse.getDWheel();
            if (wheel < 0 || Keyboard.isKeyDown(Keyboard.KEY_DOWN)) tooltipScrollY -= 1;
            else if (wheel > 0 || Keyboard.isKeyDown(Keyboard.KEY_UP)) tooltipScrollY += 1;

            if (tooltipScrollY < 0 && event.toolTip.size() > 6) {
                int removeCount = Math.min(Math.abs(tooltipScrollY), event.toolTip.size() - 4);
                for (int i = 0; i < removeCount; i++) {
                    if (event.toolTip.size() > 2) event.toolTip.remove(1);
                }
                event.toolTip.add(1, EnumChatFormatting.DARK_GRAY + "▲ [Scrolled Down - Press UP Arrow to Reset]");
            } else {
                tooltipScrollY = 0;
            }
        }

        String itemId = resolveItemId(event.itemStack);
        if (itemId == null) return;

        int count = Math.max(1, event.itemStack.stackSize);
        boolean addedHeader = false;

        // 1. Local Fakepixel Scraped BIN
        if (fakepixelLocalBinMap.containsKey(itemId)) {
            double fpBin = fakepixelLocalBinMap.get(itemId);
            event.toolTip.add("");
            addedHeader = true;
            event.toolTip.add(EnumChatFormatting.LIGHT_PURPLE + "Fakepixel Seen BIN: " + EnumChatFormatting.YELLOW + formatter.format(Math.round(fpBin)) + " coins");
        }

        // 2. Global Lowest BIN (AH)
        if (lowestBinMap.containsKey(itemId)) {
            if (!addedHeader) { event.toolTip.add(""); addedHeader = true; }
            double lbin = lowestBinMap.get(itemId);
            event.toolTip.add(EnumChatFormatting.GOLD + "Lowest BIN: " + EnumChatFormatting.YELLOW + formatter.format(Math.round(lbin)) + " coins");
            if (count > 1) {
                event.toolTip.add(EnumChatFormatting.GOLD + "Stack LBIN (" + count + "x): " + EnumChatFormatting.YELLOW + formatter.format(Math.round(lbin * count)) + " coins");
            }
        }

        // 3. Live Bazaar Buy & Sell
        if (bazaarBuyMap.containsKey(itemId)) {
            if (!addedHeader) { event.toolTip.add(""); addedHeader = true; }
            double buy = bazaarBuyMap.get(itemId) * count;
            double sell = bazaarSellMap.get(itemId) * count;
            event.toolTip.add(EnumChatFormatting.GOLD + "Bazaar Insta-Buy (" + count + "x): " + EnumChatFormatting.YELLOW + formatter.format(Math.round(buy)) + " coins");
            event.toolTip.add(EnumChatFormatting.GOLD + "Bazaar Insta-Sell (" + count + "x): " + EnumChatFormatting.YELLOW + formatter.format(Math.round(sell)) + " coins");
        }

        // 4. Show Internal Item ID at bottom if Shift is held
        if (Keyboard.isKeyDown(Keyboard.KEY_LSHIFT)) {
            event.toolTip.add(EnumChatFormatting.DARK_GRAY + "SkyBlock ID: " + itemId);
        }
    }

    private String resolveItemId(ItemStack stack) {
        if (stack == null) return null;
        if (stack.hasTagCompound()) {
            NBTTagCompound tag = stack.getTagCompound();
            if (tag.hasKey("ExtraAttributes", 10)) {
                NBTTagCompound ea = tag.getCompoundTag("ExtraAttributes");
                if (ea.hasKey("id", 8)) {
                    return ea.getString("id").toUpperCase();
                }
            }
        }
        // Smart Fallback for Fakepixel items (e.g. "Stock of Stonks" -> "STOCK_OF_STONKS")
        String rawName = StringUtils.stripControlCodes(stack.getDisplayName());
        String cleaned = rawName
                .replaceAll("[✪✦⚚⚔🏹]", "")
                .replaceAll("\\[Lvl \\d+\\]", "")
                .replaceAll(" x\\d+$", "")
                .trim();

        // Strip common SkyBlock Reforges if NBT is missing
        String[] reforges = {"Gentle ", "Odd ", "Fast ", "Fair ", "Epic ", "Sharp ", "Heroic ", "Spicy ", "Legendary ", "Fabled ", "Withered ", "Ancient ", "Necrotic ", "Loving ", "fierce ", "Pure ", "Wise ", "Renowned "};
        for (String ref : reforges) {
            if (cleaned.startsWith(ref)) {
                cleaned = cleaned.substring(ref.length()).trim();
        
