package com.universalsb.mod;

import com.google.gson.JsonElement;
import com.google.gson.JsonObject;
import com.google.gson.JsonParser;
import net.minecraft.client.Minecraft;
import net.minecraft.client.gui.FontRenderer;
import net.minecraft.client.gui.Gui;
import net.minecraft.client.gui.inventory.GuiChest;
import net.minecraft.client.gui.inventory.GuiContainer;
import net.minecraft.client.renderer.GlStateManager;
import net.minecraft.client.settings.KeyBinding;
import net.minecraft.command.CommandBase;
import net.minecraft.command.ICommandSender;
import net.minecraft.inventory.ContainerChest;
import net.minecraft.inventory.IInventory;
import net.minecraft.inventory.Slot;
import net.minecraft.item.ItemStack;
import net.minecraft.nbt.NBTTagCompound;
import net.minecraft.scoreboard.Score;
import net.minecraft.scoreboard.ScoreObjective;
import net.minecraft.scoreboard.ScorePlayerTeam;
import net.minecraft.scoreboard.Scoreboard;
import net.minecraft.util.ChatComponentText;
import net.minecraft.util.EnumChatFormatting;
import net.minecraft.util.StringUtils;
import net.minecraftforge.client.ClientCommandHandler;
import net.minecraftforge.client.event.ClientChatReceivedEvent;
import net.minecraftforge.client.event.GuiScreenEvent;
import net.minecraftforge.client.event.RenderGameOverlayEvent;
import net.minecraftforge.common.MinecraftForge;
import net.minecraftforge.event.entity.player.ItemTooltipEvent;
import net.minecraftforge.fml.client.registry.ClientRegistry;
import net.minecraftforge.fml.common.Mod;
import net.minecraftforge.fml.common.event.FMLInitializationEvent;
import net.minecraftforge.fml.common.eventhandler.SubscribeEvent;
import net.minecraftforge.fml.common.gameevent.InputEvent;
import net.minecraftforge.fml.common.gameevent.TickEvent;
import net.minecraftforge.fml.relauncher.ReflectionHelper;
import org.lwjgl.input.Keyboard;
import org.lwjgl.input.Mouse;

import java.io.*;
import java.lang.reflect.Field;
import java.net.HttpURLConnection;
import java.net.URL;
import java.text.NumberFormat;
import java.util.*;
import java.util.concurrent.ConcurrentHashMap;
import java.util.concurrent.Executors;
import java.util.concurrent.TimeUnit;
import java.util.regex.Matcher;
import java.util.regex.Pattern;

@Mod(modid = "universalsb", name = "Universal SkyBlock QoL", version = "2.0.0", clientSideOnly = true)
public class UniversalSkyblockMod {

    public static KeyBinding lockSlotKey;
    public static boolean inSkyblock = false;
    public static boolean enableTooltips = true;
    public static boolean enableHud = true;
    public static boolean enableSolvers = true;

    private static final Set<Integer> lockedSlots = new HashSet<>();
    private static File configFile;

    // Reflection fields for accurate GUI coordinates (Fixes Potion shift & 6-row chests)
    private static Field guiLeftField;
    private static Field guiTopField;

    // Economy Caches
    public static final Map<String, Double> lowestBinMap = new ConcurrentHashMap<>();
    public static final Map<String, Double> bazaarBuyMap = new ConcurrentHashMap<>();
    public static final Map<String, Double> bazaarSellMap = new ConcurrentHashMap<>();
    private final NumberFormat formatter = NumberFormat.getInstance(Locale.US);

    // HUD & Tracker States
    private String currentHealth = "100/100";
    private String currentDefense = "0";
    private String currentMana = "100/100";
    private String slayerStatus = "None";
    private int zealotKills = 0;
    private int tickCounter = 0;

    private final Pattern hpPattern = Pattern.compile("([0-9,]+/[0-9,]+)❤");
    private final Pattern defPattern = Pattern.compile("([0-9,]+)❈");
    private final Pattern manaPattern = Pattern.compile("([0-9,]+/[0-9,]+)✎");

    @Mod.EventHandler
    public void init(FMLInitializationEvent event) {
        lockSlotKey = new KeyBinding("Lock Inventory Slot", Keyboard.KEY_L, "Universal SkyBlock");
        ClientRegistry.registerKeyBinding(lockSlotKey);

        try {
            guiLeftField = ReflectionHelper.findField(GuiContainer.class, "guiLeft", "field_147003_i");
            guiTopField = ReflectionHelper.findField(GuiContainer.class, "guiTop", "field_147009_r");
            guiLeftField.setAccessible(true);
            guiTopField.setAccessible(true);
        } catch (Exception ignored) {}

        configFile = new File(Minecraft.getMinecraft().mcDataDir, "config/universalsb_locked.cfg");
        loadLockedSlots();

        MinecraftForge.EVENT_BUS.register(this);
        ClientCommandHandler.instance.registerCommand(new UsbCommand());

        Executors.newSingleThreadScheduledExecutor().scheduleAtFixedRate(() -> {
            fetchLowestBins();
            fetchBazaarPrices();
        }, 0, 5, TimeUnit.MINUTES);
    }

    // --- 1. SERVER & SCOREBOARD DETECTION (HYPIXEL + FAKEPIXEL) ---
    @SubscribeEvent
    public void onClientTick(TickEvent.ClientTickEvent event) {
        if (event.phase != TickEvent.Phase.END) return;
        Minecraft mc = Minecraft.getMinecraft();
        if (mc.theWorld == null || mc.thePlayer == null) {
            inSkyblock = false;
            return;
        }
        if (++tickCounter < 20) return;
        tickCounter = 0;

        Scoreboard sb = mc.theWorld.getScoreboard();
        if (sb == null) return;
        ScoreObjective obj = sb.getObjectiveInDisplaySlot(1);
        if (obj != null) {
            String title = StringUtils.stripControlCodes(obj.getDisplayName()).toUpperCase();
            inSkyblock = title.contains("SKYBLOCK") || title.contains("SKIBLOCK") || title.contains("FAKEPIXEL");

            // Parse Sidebar for Slayer Progress
            slayerStatus = "None";
            Collection<Score> scores = sb.getSortedScores(obj);
            for (Score score : scores) {
                ScorePlayerTeam team = sb.getPlayersTeam(score.getPlayerName());
                String line = StringUtils.stripControlCodes(ScorePlayerTeam.formatPlayerName(team, score.getPlayerName())).trim();
                if (line.contains("Slay the boss!") || line.contains("Combat XP") || line.contains("Kills")) {
                    slayerStatus = line;
                }
            }
        } else {
            inSkyblock = false;
        }
    }

    // --- 2. ECONOMY & TOOLTIP HANDLER (WITH FAKEPIXEL NAME FALLBACK) ---
    @SubscribeEvent
    public void onItemTooltip(ItemTooltipEvent event) {
        if (!inSkyblock || !enableTooltips || event.itemStack == null) return;

        String itemId = getSkyblockItemID(event.itemStack);
        if (itemId == null) return;

        int count = Math.max(1, event.itemStack.stackSize);

        if (lowestBinMap.containsKey(itemId)) {
            double lbin = lowestBinMap.get(itemId);
            event.toolTip.add(EnumChatFormatting.GOLD + "Lowest BIN: " + EnumChatFormatting.YELLOW + formatter.format(Math.round(lbin)) + " coins");
            if (count > 1) {
                event.toolTip.add(EnumChatFormatting.GOLD + "Stack LBIN (" + count + "x): " + EnumChatFormatting.YELLOW + formatter.format(Math.round(lbin * count)) + " coins");
            }
        }

        if (bazaarBuyMap.containsKey(itemId)) {
            double buy = bazaarBuyMap.get(itemId) * count;
            double sell = bazaarSellMap.get(itemId) * count;
            event.toolTip.add(EnumChatFormatting.GOLD + "Bazaar Buy (" + count + "x): " + EnumChatFormatting.YELLOW + formatter.format(Math.round(buy)) + " coins");
            event.toolTip.add(EnumChatFormatting.GOLD + "Bazaar Sell (" + count + "x): " + EnumChatFormatting.YELLOW + formatter.format(Math.round(sell)) + " coins");
        }
    }

    private String getSkyblockItemID(ItemStack stack) {
        if (stack.hasTagCompound()) {
            NBTTagCompound tag = stack.getTagCompound();
            if (tag.hasKey("ExtraAttributes", 10)) {
                NBTTagCompound ea = tag.getCompoundTag("ExtraAttributes");
                if (ea.hasKey("id", 8)) return ea.getString("id");
            }
        }
        // Fallback for Fakepixel items without standard ExtraAttributes NBT
        String cleanName = StringUtils.stripControlCodes(stack.getDisplayName())
                .replaceAll("✪", "")
                .replaceAll("\\[Lvl \\d+\\] ", "")
                .trim()
                .toUpperCase()
                .replace(" ", "_")
                .replace("'", "");
        if (lowestBinMap.containsKey(cleanName) || bazaarBuyMap.containsKey(cleanName)) {
            return cleanName;
        }
        return null;
    }

    // --- 3. SLOT LOCKING & DROP PROTECTION ---
    @SubscribeEvent
    public void onKeyInputInWorld(InputEvent.KeyInputEvent event) {
        if (!inSkyblock) return;
        Minecraft mc = Minecraft.getMinecraft();
        // Block dropping held item with Q if hotbar slot is locked
        if (mc.gameSettings.keyBindDrop.isKeyDown()) {
            int currentSlot = mc.thePlayer.inventory.currentItem;
            if (lockedSlots.contains(currentSlot)) {
                mc.thePlayer.playSound("note.bass", 1.0F, 0.5F);
                mc.thePlayer.addChatMessage(new ChatComponentText("§c[USB] That hotbar slot is locked!"));
            }
        }
    }

    @SubscribeEvent
    public void onGuiKeyInput(GuiScreenEvent.KeyboardInputEvent.Pre event) {
        if (!inSkyblock || !(event.gui instanceof GuiContainer)) return;
        GuiContainer container = (GuiContainer) event.gui;
        Slot hovered = container.getSlotUnderMouse();

        if (Keyboard.getEventKeyState()) {
            int key = Keyboard.getEventKey();
            // Toggle Lock with L
            if (key == lockSlotKey.getKeyCode() && hovered != null && hovered.inventory == Minecraft.getMinecraft().thePlayer.inventory) {
                int idx = hovered.getSlotIndex();
                if (lockedSlots.contains(idx)) {
                    lockedSlots.remove(idx);
                    Minecraft.getMinecraft().thePlayer.playSound("random.orb", 0.5F, 0.5F);
                } else {
                    lockedSlots.add(idx);
                    Minecraft.getMinecraft().thePlayer.playSound("random.orb", 0.5F, 1.5F);
                }
                saveLockedSlots();
                event.setCanceled(true);
            }
            // Block Q drop inside inventories on locked slots
            if (key == Minecraft.getMinecraft().gameSettings.keyBindDrop.getKeyCode() && hovered != null) {
                if (hovered.inventory == Minecraft.getMinecraft().thePlayer.inventory && lockedSlots.contains(hovered.getSlotIndex())) {
                    Minecraft.getMinecraft().thePlayer.playSound("note.bass", 1.0F, 0.5F);
                    event.setCanceled(true);
                }
            }
        }
    }

    @SubscribeEvent
    public void onGuiMouseClick(GuiScreenEvent.MouseInputEvent.Pre event) {
        if (!inSkyblock || !(event.gui instanceof GuiContainer) || !Mouse.getEventButtonState()) return;
        GuiContainer container = (GuiContainer) event.gui;
        Slot hovered = container.getSlotUnderMouse();
        if (hovered != null && hovered.inventory == Minecraft.getMinecraft().thePlayer.inventory) {
            if (lockedSlots.contains(hovered.getSlotIndex())) {
                Minecraft.getMinecraft().thePlayer.playSound("note.bass", 1.0F, 0.5F);
                event.setCanceled(true);
            }
        }
    }

    // --- 4. FLOOR 7 TERMINAL SOLVERS & SLOT LOCK RENDERING (OPTIFINE SAFE) ---
    @SubscribeEvent
    public void onDrawGuiPost(GuiScreenEvent.DrawScreenEvent.Post event) {
        if (!inSkyblock || !(event.gui instanceof GuiContainer)) return;
        GuiContainer containerGui = (GuiContainer) event.gui;

        int guiLeft = getGuiLeft(containerGui);
        int guiTop = getGuiTop(containerGui);

        GlStateManager.pushMatrix();
        GlStateManager.disableLighting();
        GlStateManager.disableDepth();

        // Draw Locked Slots
        for (Object obj : containerGui.inventorySlots.inventorySlots) {
            Slot slot = (Slot) obj;
            if (slot.inventory == Minecraft.getMinecraft().thePlayer.inventory && lockedSlots.contains(slot.getSlotIndex())) {
                int x = guiLeft + slot.xDisplayPosition;
                int y = guiTop + slot.yDisplayPosition;
                Gui.drawRect(x, y, x + 16, y + 16, 0x66FF0000);
            }
        }

        // Draw Floor 7 Terminal Solvers
        if (enableSolvers && event.gui instanceof GuiChest) {
            ContainerChest chest = (ContainerChest) containerGui.inventorySlots;
            IInventory inv = chest.getLowerChestInventory();
            String title = StringUtils.stripControlCodes(inv.getDisplayName().getUnformattedText()).trim();

            // Solver A: "What starts with: 'X'?"
            if (title.startsWith("What starts with: '") && title.length() >= 20) {
                String letter = title.substring(19, 20).toUpperCase();
                for (int i = 0; i < inv.getSizeInventory(); i++) {
                    Slot s = chest.getSlot(i);
                    if (s != null && s.getHasStack() && !s.getStack().isItemEnchanted()) {
                        String name = StringUtils.stripControlCodes(s.getStack().getDisplayName()).trim().toUpperCase();
                        if (name.startsWith(letter)) {
                            Gui.drawRect(guiLeft + s.xDisplayPosition, guiTop + s.yDisplayPosition, guiLeft + s.xDisplayPosition + 16, guiTop + s.yDisplayPosition + 16, 0x8800FF00);
                        }
                    }
                }
            }
            // Solver B: "Select all the [COLOR] items!"
            else if (title.startsWith("Select all the ") && title.endsWith(" items!")) {
                String color = title.replace("Select all the ", "").replace(" items!", "").trim().toUpperCase();
                for (int i = 0; i < inv.getSizeInventory(); i++) {
                    Slot s = chest.getSlot(i);
                    if (s != null && s.getHasStack() && !s.getStack().isItemEnchanted()) {
                        String name = StringUtils.stripControlCodes(s.getStack().getDisplayName()).toUpperCase();
                        if (name.contains(color) || (color.equals("SILVER") && name.contains("LIGHT GRAY"))) {
                            Gui.drawRect(guiLeft + s.xDisplayPosition, guiTop + s.yDisplayPosition, guiLeft + s.xDisplayPosition + 16, guiTop + s.yDisplayPosition + 16, 0x8800FF00);
                        }
                    }
                }
            }
            // Solver C: "Click in order!" (Numbers 1-14)
            else if (title.equalsIgnoreCase("Click in order!")) {
                int minStack = 99;
                Slot nextSlot = null;
                for (int i = 0; i < inv.getSizeInventory(); i++) {
                    Slot s = chest.getSlot(i);
                    if (s != null && s.getHasStack() && s.getStack().getItemDamage() == 14) { // Red stained glass pane = unclicked
                        if (s.getStack().stackSize < minStack) {
                            minStack = s.getStack().stackSize;
                            nextSlot = s;
                        }
                    }
                }
                if (nextSlot != null) {
                    Gui.drawRect(guiLeft + nextSlot.xDisplayPosition, guiTop + nextSlot.yDisplayPosition, guiLeft + nextSlot.xDisplayPosition + 16, guiTop + nextSlot.yDisplayPosition + 16, 0x9900FF00);
                }
            }
        }

        GlStateManager.enableDepth();
        GlStateManager.color(1.0F, 1.0F, 1.0F, 1.0F);
        GlStateManager.popMatrix();
    }

    // --- 5. HUD, ALERTS & ACTION BAR PARSER ---
    @SubscribeEvent
    public void onChat(ClientChatReceivedEvent event) {
        if (!inSkyblock) return;
        String clean = StringUtils.stripControlCodes(event.message.getUnformattedText());

        if (event.type == 2) { // Action Bar
            Matcher hp = hpPattern.matcher(clean);
            if (hp.find()) currentHealth = hp.group(1);
            Matcher def = defPattern.matcher(clean);
            if (def.find()) currentDefense = def.group(1);
            Matcher mana = manaPattern.matcher(clean);
            if (mana.find()) currentMana = mana.group(1);
            return;
        }

        if (clean.contains("RARE DROP!") || clean.contains("CRAZY RARE DROP!") || clean.contains("INSANE DROP!")) {
            Minecraft.getMinecraft().thePlayer.playSound("random.levelup", 1.0F, 0.5F);
            Minecraft.getMinecraft().ingameGUI.displayTitle("§6§lRARE DROP!", "§e" + clean, 5, 45, 10);
        } else if (clean.contains("A special Zealot has spawned nearby!")) {
            Minecraft.getMinecraft().thePlayer.playSound("mob.wither.spawn", 1.0F, 1.0F);
            Minecraft.getMinecraft().ingameGUI.displayTitle("§c§lSPECIAL ZEALOT!", "§e Eyes Reset! (" + zealotKills + " kills)", 5, 55, 10);
            zealotKills = 0;
        }
    }

    @SubscribeEvent
    public void onRenderOverlay(RenderGameOverlayEvent.Post event) {
        if (!inSkyblock || !enableHud || event.type != RenderGameOverlayEvent.ElementType.TEXT) return;
        Minecraft mc = Minecraft.getMinecraft();
        FontRenderer fr = mc.fontRendererObj;

        GlStateManager.pushMatrix();
        fr.drawStringWithShadow("§c❤ HP: §f" + currentHealth, 8, 8, 0xFFFFFF);
        fr.drawStringWithShadow("§a❈ DEF: §f" + currentDefense, 8, 19, 0xFFFFFF);
        fr.drawStringWithShadow("§b✎ MANA: §f" + currentMana, 8, 30, 0xFFFFFF);

        float yaw = Math.abs(mc.thePlayer.rotationYaw % 360);
        float pitch = mc.thePlayer.rotationPitch;
        fr.drawStringWithShadow(String.format("§e🌾 Angle: §fYaw %.1f° | Pitch %.1f°", yaw, pitch), 8, 41, 0xFFFFFF);

        if (!slayerStatus.equals("None")) {
            fr.drawStringWithShadow("§5☠ Slayer: §f" + slayerStatus, 8, 52, 0xFFFFFF);
        }

        GlStateManager.color(1.0F, 1.0F, 1.0F, 1.0F);
        GlStateManager.popMatrix();
    }

    // --- HELPERS & API FETCHERS ---
    private int getGuiLeft(GuiContainer gui) {
        try { if (guiLeftField != null) return guiLeftField.getInt(gui); } catch (Exception ignored) {}
        return (gui.width - 176) / 2;
    }

    private int getGuiTop(GuiContainer gui) {
        try { if (guiTopField != null) return guiTopField.getInt(gui); } catch (Exception ignored) {}
        return (gui.height - 166) / 2;
    }

    private static void saveLockedSlots() {
        try (PrintWriter out = new PrintWriter(new FileWriter(configFile))) {
            for (int slot : lockedSlots) out.println(slot);
        } catch (Exception ignored) {}
    }

    private static void loadLockedSlots() {
        if (!configFile.exists()) return;
        try (BufferedReader br = new BufferedReader(new FileReader(configFile))) {
            String line;
            while ((line = br.readLine()) != null) lockedSlots.add(Integer.parseInt(line.trim()));
        } catch (Exception ignored) {}
    }

    private static void fetchLowestBins() {
        try {
            HttpURLConnection conn = (HttpURLConnection) new URL("https://moulberry.codes/lowestbin.json").openConnection();
            conn.setRequestProperty("User-Agent", "UniversalSkyblockMod/2.0");
            JsonObject json = new JsonParser().parse(new InputStreamReader(conn.getInputStream())).getAsJsonObject();
            for (Map.Entry<String, JsonElement> e : json.entrySet()) lowestBinMap.put(e.getKey(), e.getValue().getAsDouble());
        } catch (Exception ignored) {}
    }

    private static void fetchBazaarPrices() {
        try {
            HttpURLConnection conn = (HttpURLConnection) new URL("https://api.hypixel.net/skyblock/bazaar").openConnection();
            JsonObject products = new JsonParser().parse(new InputStreamReader(conn.getInputStream())).getAsJsonObject().getAsJsonObject("products");
            for (Map.Entry<String, JsonElement> e : products.entrySet()) {
                JsonObject qs = e.getValue().getAsJsonObject().get
